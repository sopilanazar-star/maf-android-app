<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="#1E1E1E"
    android:layout_marginBottom="1dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMatchTeams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ураган - Устя"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMatchDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24.03.2026"
            android:textColor="#888888"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlayerPrediction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="2 : 1"
        android:textColor="#4FA3FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvRealScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="1 : 1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvMatchPoints"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:text="+1"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="end" />

</LinearLayout>