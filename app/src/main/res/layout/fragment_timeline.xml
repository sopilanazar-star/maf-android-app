<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1D23"
    android:fillViewport="true"
    
    android:paddingBottom="88dp"
    android:clipToPadding="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/centerLine"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignTop="@+id/timelineContainer"
            android:layout_alignBottom="@+id/timelineContainer"
            android:background="#333A45"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTimelineLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Завантаження подій..."
            android:textColor="#808080"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/timelineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="@null"
            
            android:paddingBottom="20dp" />

    </RelativeLayout>
</ScrollView>
