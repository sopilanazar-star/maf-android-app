<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1D23">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutCompetitions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabGravity="fill"
        app:tabTextColor="#BCBCBC"
        app:tabSelectedTextColor="#E30613"
        app:tabIndicatorColor="#E30613"
        app:tabRippleColor="@android:color/transparent"
        android:background="#1A1D23" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStanding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="4dp"
        
        /* Нижній відступ (88dp), щоб остання команда 
           піднімалася над панеллю навігації 
        */
        android:paddingBottom="88dp"
        
        /* Дозволяє списку прокручуватися під відступом, 
           але зупиняє його вище панелі в самому кінці 
        */
        android:clipToPadding="false"
        
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
